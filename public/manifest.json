{
  "manifest_version": 3,
  "name": "LinkedIn Super Powers",
  "version": "0.1.0",
  "description": "Abre notificacoes do LinkedIn em drawer sem sair do feed.",
  "permissions": ["tabs"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "LinkedIn Super Powers",
    "default_popup": "src/popup/index.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["assets/content.js"],
      "run_at": "document_idle"
    }
  ]
}
